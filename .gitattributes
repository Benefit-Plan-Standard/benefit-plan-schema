# Normalize line endings across platforms.
* text=auto eol=lf

# JSON and Markdown — always LF
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Schema files are canonical artifacts — treat as text, never CRLF
*.schema.json text eol=lf

# Binary
*.png binary
*.jpg binary
*.pdf binary

# PBP fixtures are byte-for-byte cuts of CMS files (Windows-1252, CRLF); the
# importer requires CRLF, so git must not convert them.
test/fixtures/pbp/**/*.txt -text
