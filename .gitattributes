# Normalize line endings across platforms.
* text=auto eol=lf

# JSON and Markdown — always LF
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Schema files are canonical artifacts — treat as text, never CRLF
*.schema.json text eol=lf

# Binary
*.png binary
*.jpg binary
*.pdf binary
