      "count": 10
    },
    "home_health": {
      "description": "Home-based skilled care, home health aides, home therapies, and hospice.",
      "count": 5
    },
    "maternity": {
      "description": "Prenatal, delivery, postnatal, and newborn care.",
      "count": 9
    },
    "other": {
      "description": "Other services (emergency, urgent care, ambulance, excluded/non-covered placeholders).",
      "count": 5
    },
    "pharmacy": {
      "description": "Prescription drugs by formulary tier (generic, preferred brand, non-preferred brand, specialty, preventive).",
      "count": 10
    },
    "preventive": {
      "description": "Preventive care including well visits, immunizations, mammograms, colonoscopies, and well-woman exams.",
      "count": 7
    },
    "professional_services": {
      "description": "Office and professional-fee services (PCP, specialist, chiropractic, acupuncture, telehealth, surgeon professional fees).",
      "count": 11
    },
    "rehabilitation": {
      "description": "Physical, occupational, speech, cardiac, and pulmonary rehabilitation; habilitative services.",
      "count": 10
    },
    "specialty_care": {
      "description": "Specialty treatments (chemotherapy, radiation, dialysis, DME, prosthetics, infertility, bariatric, nutrition).",
      "count": 17
    },
    "vision": {
      "description": "Vision services (commonly pediatric on medical plans; full vision typically on a vision module).",
      "count": 2
    }
